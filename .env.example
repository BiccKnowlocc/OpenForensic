# Host environment only. Never commit a real Atlas connection string.
# Atlas project name: OpenForensic
# Atlas cluster name: OpenForensic
# Database name: OpenForensic
MONGODB_URI=mongodb+srv://USER:PASSWORD@openforensic.example.mongodb.net/OpenForensic?retryWrites=true&w=majority

# The deployed viewer uses the Netlify AI Gateway.
# Do not set OPENAI_API_KEY, ANTHROPIC_API_KEY, or GEMINI_API_KEY.
# A key in the environment bypasses the gateway and is not how this app authenticates.
